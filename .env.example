# Fichier généré automatiquement par ./script.sh — tu n'as normalement pas besoin d'y toucher.
# Le reste des réglages (ntfy, filtres…) se fait dans l'interface web ou via ./script.sh.

# Mot de passe de l'interface web (8 caractères minimum)
WEB_PASSWORD='change-moi-svp'
# Port de l'interface web sur le serveur
WEB_PORT=8080
# 127.0.0.1 = accessible seulement depuis le serveur (conseillé avec un reverse proxy)
# 0.0.0.0   = accessible depuis tout le réseau
WEB_BIND=127.0.0.1
