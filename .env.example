# ---- ntfy ----
# Ton serveur ntfy (ou https://ntfy.sh)
NTFY_URL=https://ntfy.exemple.fr
NTFY_TOPIC=failles-securite
# Si ton topic est protégé : un token OU user/mot de passe
NTFY_TOKEN=
NTFY_USER=
NTFY_PASSWORD=

# ---- NVD ----
# Clé gratuite : https://nvd.nist.gov/developers/request-an-api-key
# (sans clé ça marche, mais l'API est 10x plus lente)
NVD_API_KEY=

# ---- Filtrage ----
# NONE = toutes les failles (~100 à 150 par jour !), sinon LOW / MEDIUM / HIGH / CRITICAL
MIN_SEVERITY=NONE
# Optionnel : ne garder que les CVE qui mentionnent un de ces mots (séparés par des virgules)
# ex : KEYWORDS=debian,apache,php,openssh,docker
KEYWORDS=

# ---- Divers ----
CHECK_INTERVAL_MIN=15
# Au tout premier lancement, remonter jusqu'à X heures en arrière
FIRST_RUN_LOOKBACK_H=2
# Notification "veilleur démarré" au lancement
STARTUP_NOTIFY=true
